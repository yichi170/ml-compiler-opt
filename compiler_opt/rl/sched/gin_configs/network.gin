import compiler_opt.rl.gin_external_configurables
import compiler_opt.rl.sched.config
import compiler_opt.rl.sched.sched_network

sched.config.get_observation_processing_layer_creator.quantile_file_dir='compiler_opt/rl/sched/vocab'
sched.config.get_observation_processing_layer_creator.with_sqrt = False
sched.config.get_observation_processing_layer_creator.with_z_score_normalization = False

create_agent.policy_network = @sched_network.SchedNetwork

SchedNetwork.preprocessing_combiner=@tf.keras.layers.Concatenate()
SchedNetwork.fc_layer_params=(80, 40)
SchedNetwork.dropout_layer_params=None
SchedNetwork.activation_fn=@tf.keras.activations.relu
