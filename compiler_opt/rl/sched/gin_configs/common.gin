config_registry.get_configuration.implementation=@configs.InstructionSchedulingConfig

launcher_path=None
clang_path=None

runners.SchedRunner.clang_path=%clang_path
runners.SchedRunner.launcher_path=%launcher_path

problem_config.flags_to_add.add_flags=('-Wno-backend-plugin',)
problem_config.flags_to_delete.delete_flags=('-split-dwarf-file','-split-dwarf-output','-amdgpu-coerce-illegal-types=1','-amdgpu-early-inline-all=true')
